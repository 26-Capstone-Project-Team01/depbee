# Allowlist: nothing enters the Docker build context unless it is named here, so a host .git,
# .venv, .env, cache, test, model or data file can never reach an image layer.
**
!pyproject.toml
!README.md
# Modules, one line per package directory, so that a stray folder under the package stays out.
# A new subpackage needs its own line here.
!src/depbee/*.py
!src/depbee/analysis/*.py
!src/depbee/dashboard/*.py
!src/depbee/inference/*.py
!src/depbee/inputs/*.py
# Package data: the same patterns and paths as [tool.setuptools.package-data] in pyproject.toml.
!src/depbee/dashboard/templates/*.html
!src/depbee/dashboard/static/*.css
!src/depbee/assets/NOTICE.md
!src/depbee/assets/LICENSE-Apache-2.0.txt
!src/depbee/assets/model/manifest.json
!src/depbee/assets/model/model.txt
!src/depbee/assets/index/manifest.json
!src/depbee/assets/index/index.json
# Last, so that it wins: no hidden file, even one that a pattern above matches (._x.py, .#x.py).
**/.*
